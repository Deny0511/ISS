<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.ui.AirportController"
      spacing="14"
      style="-fx-background-color: #0f172a;
             -fx-padding: 24;">

    <Label text="🛫  Gestionare aeroporturi"
           style="-fx-text-fill: #60a5fa;
                  -fx-font-size: 20px;
                  -fx-font-weight: bold;"/>

    <TableView fx:id="table" VBox.vgrow="ALWAYS"
               prefHeight="300"
               style="-fx-background-color: #1e293b;
                      -fx-background-radius: 10;
                      -fx-border-color: #334155;
                      -fx-border-radius: 10;
                      -fx-border-width: 1.5;">
        <columns>
            <TableColumn fx:id="colCode"    text="Cod"   prefWidth="100"/>
            <TableColumn fx:id="colCity"    text="Oraș"  prefWidth="200"/>
            <TableColumn fx:id="colCountry" text="Țară"  prefWidth="200"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <HBox spacing="10">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Cod" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            <TextField fx:id="codeField" promptText="ex: CLJ"
                       style="-fx-background-color: #1e293b;
                              -fx-text-fill: white;
                              -fx-prompt-text-fill: #475569;
                              -fx-background-radius: 8;
                              -fx-border-color: #334155;
                              -fx-border-radius: 8;
                              -fx-border-width: 1.5;
                              -fx-padding: 9 12;
                              -fx-font-size: 13px;"/>
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Oraș" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            <TextField fx:id="cityField" promptText="ex: Cluj-Napoca"
                       style="-fx-background-color: #1e293b;
                              -fx-text-fill: white;
                              -fx-prompt-text-fill: #475569;
                              -fx-background-radius: 8;
                              -fx-border-color: #334155;
                              -fx-border-radius: 8;
                              -fx-border-width: 1.5;
                              -fx-padding: 9 12;
                              -fx-font-size: 13px;"/>
        </VBox>
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Țară" style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
            <TextField fx:id="countryField" promptText="ex: Romania"
                       style="-fx-background-color: #1e293b;
                              -fx-text-fill: white;
                              -fx-prompt-text-fill: #475569;
                              -fx-background-radius: 8;
                              -fx-border-color: #334155;
                              -fx-border-radius: 8;
                              -fx-border-width: 1.5;
                              -fx-padding: 9 12;
                              -fx-font-size: 13px;"/>
        </VBox>
    </HBox>

    <HBox spacing="10">
        <Button text="➕  Adaugă"
                onAction="#handleAdd"
                style="-fx-background-color: #2563eb;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-padding: 10 20;
                       -fx-font-size: 13px;
                       -fx-cursor: hand;"/>

        <Button text="✏  Actualizează"
                onAction="#handleUpdate"
                style="-fx-background-color: #1e3a5f;
                       -fx-text-fill: #93c5fd;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-border-color: #2563eb;
                       -fx-border-radius: 8;
                       -fx-border-width: 1.5;
                       -fx-padding: 10 20;
                       -fx-font-size: 13px;
                       -fx-cursor: hand;"/>

        <Button text="🗑  Șterge"
                onAction="#handleDelete"
                style="-fx-background-color: #7f1d1d;
                       -fx-text-fill: #fca5a5;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-padding: 10 20;
                       -fx-font-size: 13px;
                       -fx-cursor: hand;"/>
    </HBox>

    <Label fx:id="messageLabel"
           style="-fx-text-fill: #60a5fa;
                  -fx-font-size: 12px;
                  -fx-font-style: italic;"/>

</VBox>