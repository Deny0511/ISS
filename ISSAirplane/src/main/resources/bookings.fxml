<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.ui.BookingController"
            prefHeight="500.0" prefWidth="700.0"
            style="-fx-background-color: #0f172a;
                   -fx-padding: 24;">

    <VBox spacing="14"
          AnchorPane.topAnchor="0"
          AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0"
          AnchorPane.bottomAnchor="0">

        <Label text="📋  Rezervările mele"
               style="-fx-text-fill: #60a5fa;
                      -fx-font-size: 20px;
                      -fx-font-weight: bold;"/>

        <TableView fx:id="bookingsTable" VBox.vgrow="ALWAYS"
                   style="-fx-background-color: #1e293b;
                          -fx-background-radius: 10;
                          -fx-border-color: #334155;
                          -fx-border-radius: 10;
                          -fx-border-width: 1.5;">
            <columns>
                <TableColumn fx:id="colFrom"        text="De la"    prefWidth="110"/>
                <TableColumn fx:id="colDestination" text="Spre"     prefWidth="110"/>
                <TableColumn fx:id="colDate"        text="Plecare"  prefWidth="160"/>
                <TableColumn fx:id="colSeats"       text="Locuri"   prefWidth="70"/>
                <TableColumn fx:id="colTourists"    text="Turiști"  prefWidth="150"/>
                <TableColumn fx:id="colPrice"       text="Preț"     prefWidth="80"/>
                <TableColumn fx:id="colPaid"        text="Plătit"   prefWidth="80"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <Label fx:id="messageLabel"
               style="-fx-text-fill: #60a5fa;
                      -fx-font-size: 12px;
                      -fx-font-style: italic;"/>

        <HBox spacing="12">
            <Button text="💳  Plătește"
                    onAction="#handlePay"
                    style="-fx-background-color: #2563eb;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-padding: 10 24;
                           -fx-font-size: 13px;
                           -fx-cursor: hand;"/>

            <Button text="✖  Anulează rezervarea"
                    onAction="#handleCancel"
                    style="-fx-background-color: #7f1d1d;
                           -fx-text-fill: #fca5a5;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-padding: 10 24;
                           -fx-font-size: 13px;
                           -fx-cursor: hand;"/>
        </HBox>

    </VBox>

</AnchorPane>